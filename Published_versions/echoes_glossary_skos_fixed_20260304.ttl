@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix echoes: <https://vocabs.ilc4clarin.ilc.cnr.it/vocabularies/echoes/> .
@prefix iso639-3: <http://iso639-3.sil.org/code/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


echoes:AI_application a skos:Concept ;
    dct:source "Source of term: letters; source of definition: ISO/IEC 5339:2024(en) [adapted]" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "a system, tool or service that uses artificial intelligence (AI) techniques to automate or enhance specific tasks to deliver an intended result"@en,
        "un sistema, uno strumento o un servizio che utilizza tecniche di intelligenza artificiale (AI) per automatizzare o migliorare compiti specifici allo scopo di fornire il risultato atteso"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "AI application"@en,
        "applicazione dell'IA"@it .

echoes:Artifical_Intelligence_AI a skos:Concept ;
    dct:source "Source of term: letters; source of definition: https://www.dictionary.com/browse/AI [exact]" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "the ability of a computer, robot, programmed device, or software application to perform operations and tasks analogous to human learning and decision making"@en,
        "la capacità di un computer, robot, dispositivo programmato o applicazione software di eseguire operazioni e compiti analoghi all'apprendimento e al processo decisionale umano"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "Artifical Intelligence (AI)"@en,
        "intelligenza artificiale"@it .

echoes:Common_European_Data_Space a skos:Concept ;
    dct:source "Source of term: website; source of definition: https://dssc.eu/space/bv15e/766061351/Introduction+-+Key+Concepts+of+Data+Spaces#1.-What-Is-a-Data-Space?    see also https://digital-strategy.ec.europa.eu/en/policies/data-spaces" ;
    skos:broader echoes:Other_topics_of_interest ;
    skos:definition "an interoperable framework developed by European Commission, based on common governance principles, standards, practices and enabling services, that enables trusted data transactions between participants"@en,
        "un quadro interoperabile sviluppato dalla Commissione europea, basato su principi, standard, pratiche e servizi abilitanti di governance comuni, che consente transazioni di dati affidabili tra i partecipanti"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "Common European Data Space"@en,
        "Spazio Comune Europeo dei Dati"@it .

echoes:Common_European_Data_Space_for_Cultural_Heritage a skos:Concept ;
    dct:source "Source of term: website; source of definition: https://iate.europa.eu/search/result/1745954703618/1 [exact] see also https://www.dataspace-culturalheritage.eu/en" ;
    skos:broader echoes:Other_topics_of_interest ;
    skos:definition "data space that has been designed to support the creation, sharing and reuse of cultural content within the cultural and and creative sectors"@en,
        "spazio dati che è stato progettato per supportare la creazione, la condivisione e il riutilizzo di contenuti culturali all'interno dei settori culturali e creativi"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "Common European Data Space for Cultural Heritage"@en,
        "Spazio Comune Europeo dei Dati per il Patrimonio Culturale"@it .

echoes:Data_Space a skos:Concept ;
    dct:source "Source of term: website; source of definition: https://iate.europa.eu/search/result/1745954703618/1 [exact]" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "secure and standardised digital infrastructure that enables trusted data transactions among various stakeholders based on common protocols and formats"@en,
        "infrastruttura digitale sicura e standardizzata che consente transazioni di dati affidabili tra i vari soggetti interessati sulla base di protocolli e formati comuni"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "data space"@en,
        "Spazio di Dati"@it .

echoes:FAIR_data a skos:Concept ;
    dct:source "Source of term: WP5.3 course; source of definition: Sielli, A., Avgousti, A., Hermon, S., Demetrescu, E., Kowalska, J., Pawlikowski, K., Axaridou, A., Cignoni, P., Andújar, C., Durco, M., Kritsotakis, E., Theodoridou, M., Tzortzakakis, E., & Pitikakis, M. (2025). ECHOES Data Strategy for the CH Knowledge Base (D6.1). Zenodo. https://doi.org/10.5281/zenodo.17751757" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "a framework for enhancing scientific data management by ensuring data is Findable, Accessible, Interoperable, and Reusable"@en,
        "un quadro per migliorare la gestione dei dati scientifici garantendo che i dati siano trovabili, accessibili, interoperabili e riutilizzabili"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "FAIR data"@en,
        "dati FAIR"@it .

echoes:NoSQL_database a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: https://en.wikipedia.org/wiki/NoSQL" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "a class of non-relational database systems that use flexible data models, such as key–value, document, wide-column, or graph models, to store and retrieve data without requiring a fixed schema"@en,
        "una classe di sistemi di database non relazionali che utilizzano modelli di dati flessibili, come modelli chiave-valore, documento, colonna larga o grafico, per archiviare e recuperare dati senza richiedere uno schema fisso"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "NoSQL database"@en,
        "NoSQL database"@it .

echoes:UNESCO a skos:Concept ;
    dct:source "Source of term: letters; source of definition: https://iate.europa.eu/search/result/1743109280713/1 [exact]" ;
    skos:broader echoes:Other_topics_of_interest ;
    skos:definition "UN specialised agency established in 1945 to contribute to peace and security by promoting collaboration among the nations through education, science and culture in order to further universal respect for justice, for the rule of law and for the human rights and fundamental freedoms which are affirmed for the peoples of the world, without distinction of race, sex, language or religion, by the Charter of the United Nations"@en,
        "Agenzia specializzata delle Nazioni Unite istituita nel 1945 per contribuire alla pace e alla sicurezza promuovendo la collaborazione tra le nazioni attraverso l'istruzione, la scienza e la cultura al fine di promuovere il rispetto universale della giustizia, dello stato di diritto e dei diritti umani e delle libertà fondamentali che sono affermati per i popoli del mondo, senza distinzione di razza, sesso, lingua o religione, dalla Carta delle Nazioni Unite"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "UNESCO"@en,
        "UNESCO/Organizzazione delle Nazioni Unite per l'educazione, la scienza e la Cultura"@it .

echoes:ancient_painting a skos:Concept ;
    dct:source "Source of term: website; source of definition: https://en.wikipedia.org/wiki/Ancient_art  [adapted]" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "an artistic practice of applying pigment to surfaces, such as walls, pottery, wood, and stone, originating from the earliest periods of human history (40,000 BCE - 600 CE)"@en,
        "una pratica artistica di applicazione di pigmenti su superfici, come pareti, ceramiche, legno e pietra, risalente ai primi periodi della storia umana (40.000 a.C. - 600 d.C.)"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "ancient painting"@en,
        "pittura antica"@it .

echoes:archaeology a skos:Concept ;
    dct:source "Source of term: website; source of definition: Encyclopedia of Archaeology (Second Edition), Volume 1, 2024" ;
    skos:broader echoes:Cultural_Heritage ;
    skos:definition "a multifaceted field concerned mainly with the recovery and interpretation of the material remains of the human past, and the environmental contexts in which those remains were originally deposited"@en,
        "un complesso campo di studi che ha riguardato principalmente il recupero e l'interpretazione dei resti materiali del passato umano e dei contesti ambientali in cui quei resti sono stati originariamente depositati"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "archaeology"@en,
        "archeologia"@it .

echoes:archive a skos:Concept ;
    dct:source "Source of term: manual addition; source of definition: Herein System Terminology [exact]" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "a physical repository comprising  documents, artefacts and records on any type of medium, produced and received by a public or private body and sorted, inventorised, organised and stored with a view to possible future use"@en,
        "uun archivio fisico comprendente  documenti, manufatti e registrazioni su qualsiasi tipo di supporto, prodotti e ricevuti da un ente pubblico o privato e ordinati, inventariati, organizzati e conservati in vista di un possibile utilizzo futuro"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "archive"@en,
        "archivio"@it .

echoes:artefact a skos:Concept ;
    dct:source "Source of term: website; source of definition: based on AAT, ICOM and UNESCO" ;
    skos:broader echoes:Cultural_Heritage ;
    skos:definition "a tangible object that has been created, modified, or used by human beings and is preserved for its historical, scientific, social or aesthetic value"@en,
        "un oggetto tangibile che è stato creato, modificato o utilizzato dagli esseri umani e viene preservato per il suo valore storico, scientifico, sociale o estetico"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "artefact"@en,
        "artefatto, manufatto"@it .

echoes:born-digital_record a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: https://www.nationalarchives.gov.uk/information-management/manage-information/digital-records-transfer/what-are-born-digital-records/" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "a record that has been natively created in digital format (rather than digitised from a paper record)"@en,
        "un record che è stato creato nativamente in formato digitale (piuttosto che digitalizzato da un record cartaceo)"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "born-digital record"@en,
        "risorsa digitale nativa"@it .

echoes:cold_data a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: https://en.wikipedia.org/wiki/Cold_data" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "data in computer storage that is rarely accessed"@en,
        "dati nella memoria del computer a cui si accede raramente"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "cold data"@en,
        "dati freddi"@it .

echoes:collection a skos:Concept ;
    dct:source "Source of term: letters; source of definition: https://loterre.istex.fr/th63/en/page/?uri=http%3A%2F%2Fdata.loterre.fr%2Fark%3A%2F67375%2FFM8-KSK24QP5-F [exact]" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "an assemblage of specimens compiled and maintained for purposes of study and (or) display"@en,
        "un insieme di campioni compilati e mantenuti a scopo di studio e (o) visualizzazione"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "collection"@en,
        "collezione, raccolta"@it .

echoes:conservation a skos:Concept ;
    dct:source "Source of term: letters; source of definition: Herein System Terminology (https://www.coe.int/en/web/herein-system/terminology)" ;
    skos:broader echoes:Other_topics_of_interest ;
    skos:definition "different types of actions required in the management of change aiming to prolong the life of a cultural heritage asset while  protecting its authenticity, historical and artistic integrity, without the loss of  meaning"@en,
        "diversi tipi di azioni richieste nella gestione del cambiamento volte a prolungare la vita di un bene del patrimonio culturale proteggendone l'autenticità, l'integrità storica e artistica, senza perdita di significato"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "conservation"@en,
        "conservazione"@it .

echoes:controlled_vocabulary a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: https://vocabs.sshopencloud.eu/browse/sshocterm/en/page/controlled_vocabulary_11" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "set of values that can be used either to constrain the set of permissible values or to provide suggestions for applicable values in a given context"@en,
        "insieme di valori che possono essere utilizzati per vincolare l'insieme di valori consentiti o per fornire suggerimenti per i valori applicabili in un determinato contesto"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "controlled vocabulary"@en .

echoes:cultural_heritage a skos:Concept ;
    dct:source "Source of term: letters; source of definition: Faro Convention, 2005 (https://www.coe.int/en/web/culture-and-heritage/faro-convention)" ;
    skos:broader echoes:Cultural_Heritage ;
    skos:definition "a group of resources inherited from the past which people identify, independently of ownership, as a reflection and expression of their constantly evolving values, beliefs, knowledge and traditions"@en,
        "un insieme di risorse ereditate dal passato che le persone identificano, indipendentemente dalla proprietà, come riflesso ed espressione dei loro valori, credenze, conoscenze e tradizioni in continua evoluzione"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "cultural heritage"@en,
        "patrimonio culturale"@it .

echoes:cultural_heritage_cloud a skos:Concept ;
    dct:source "Source of term: website; source of definition: https://research-and-innovation.ec.europa.eu/research-area/social-sciences-and-humanities/cultural-heritage-and-cultural-and-creative-industries-ccis/cultural-heritage-cloud_en" ;
    skos:broader echoes:Other_topics_of_interest ;
    skos:definition "a secure digital ecosystem (infrastructure) providing shared access to advance digital tools and data, enabling multidisciplinary collaboration between researchers and heritage professionals and the enhancement of cultural assets without the requirement for localised, high-cost IT infrastructure"@en,
        "un ecosistema digitale sicuro (infrastruttura) che fornisce accesso condiviso a strumenti e dati digitali avanzati, consentendo la collaborazione multidisciplinare tra ricercatori e professionisti del patrimonio e la valorizzazione dei beni culturali senza la necessità di infrastrutture IT localizzate e ad alto costo"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "cultural heritage cloud"@en,
        "cultural heritage cloud"@it .

echoes:cultural_heritage_data a skos:Concept ;
    dct:source "Source of term: letters; source of definition: https://www.getty.edu/vow/AATFullDisplay?find=data&logic=AND&note=&english=N&prev_page=1&subjectid=300312038 [adapted]" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "any structured or unstructured information in digital form that represents, documents, measures, interprets, or contextualizes tangible or intangible cultural heritage objects, sites, practices, or phenomena, which might include their associated metadata, provenance, and relational context (e.g. images, texts, audio recordings, measurements, 3D models)"@en,
        "qualsiasi informazione strutturata o non strutturata in formato digitale che rappresenti, documenti, misuri, interpreti o contestualizzi oggetti, siti, pratiche o fenomeni del patrimonio culturale tangibile o intangibile, che potrebbero includere i relativi metadati, la provenienza e il contesto relazionale (ad esempio immagini, testi, registrazioni audio, misurazioni, modelli 3D)"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "cultural heritage data"@en,
        "dati relativi al patrimonio culturale"@it .

echoes:cultural_heritage_institution a skos:Concept ;
    dct:source "Source of term: website; source of definition: https://iate.europa.eu/search/result/1745954703618/1  [exact]" ;
    skos:broader echoes:Other_topics_of_interest ;
    skos:definition "organisation whose mission resides in safeguarding, protecting, conserving and disseminating the cultural heritage of a state"@en,
        "organizzazione la cui missione risiede nella salvaguardia, protezione, conservazione e diffusione del patrimonio culturale di uno Stato"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "cultural heritage institution"@en,
        "istituto di tutela del patrimonio culturale"@it .

echoes:culture a skos:Concept ;
    dct:source "Source of term: letters; source of definition: https://en.wiktionary.org/wiki/culture [exact]" ;
    skos:broader echoes:Other_topics_of_interest ;
    skos:definition "the arts, customs, lifestyles, background and habits that characterize humankind, or a particular society or nation"@en,
        "le arti, i costumi, gli stili di vita, il background e le abitudini che caratterizzano il genere umano, o una particolare società o nazione"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "culture"@en,
        "cultura"@it .

echoes:data_analysis a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: https://vocabs.sshopencloud.eu/browse/sshocterm/en/page/data_analysis_18" ;
    skos:broader echoes:Other_topics_of_interest ;
    skos:definition "the process of inspecting, cleaning, transforming, and modeling data with the goal of highlighting useful information, suggesting conclusions, and supporting decision making."@en,
        "il processo di ispezione, pulizia, trasformazione e modellazione dei dati con l'obiettivo di evidenziare informazioni utili, suggerire conclusioni e supportare il processo decisionale"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "data analysis"@en,
        "analisi dei dati"@it .

echoes:data_management_plan a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: https://vocabs.sshopencloud.eu/browse/sshocterm/en/page/data_management_plan_65" ;
    skos:broader echoes:Other_topics_of_interest ;
    skos:definition "formal document that outlines how to handle research data both during your research and after the research project is completed."@en,
        "documento formale che delinea come gestire i dati della ricerca sia durante la ricerca che dopo il completamento del progetto di ricerca."@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "data management plan"@en,
        "piano di gestione dei dati"@it .

echoes:data_model a skos:Concept ;
    dct:source "Source of term: WP5.3 course; source of definition: ECCCH_Report_FINAL.pdf" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "a format system of constructs and rules used to represent, organise, and constrain data and its relationships within a database or information system"@en,
        "un sistema di formati di costrutti e regole utilizzato per rappresentare, organizzare e limitare i dati e le loro relazioni all'interno di un database o di un sistema informativo"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "data model"@en,
        "modello dati"@it .

echoes:data_modeling a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: https://vocabs.sshopencloud.eu/browse/sshocterm/en/page/data_modeling_71 [exact]" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "the process of applying a formal data model to represent and structure data, its relationships, and constraints in order to support information system design and facilitate reliable data exchange"@en,
        "il processo di applicazione di un modello di dati formale per rappresentare e strutturare i dati, le loro relazioni e i loro vincoli al fine di supportare la progettazione di sistemi informativi e facilitare uno scambio affidabile dei dati"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "data modeling"@en,
        "modellazione dei dati"@it .

echoes:data_processing a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: ISO/IEC 20944-1:2013(en)" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "systematic performance of operations upon data"@en,
        "esecuzione sistematica di operazioni sui dati"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "data processing"@en,
        "processazione dei dati"@it .

echoes:data_repository a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: ISO 20691:2022(en)" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "a digital system designed to collect, organise, manage and preserve data along with associated metadata for retrieval, analysis, sharing, and long-term use within or across information systems"@en,
        "un sistema digitale progettato per raccogliere, organizzare, gestire e conservare dati insieme ai metadati associati per il recupero, l'analisi, la condivisione e l'utilizzo a lungo termine all'interno o tra sistemi informativi"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "data repository"@en,
        "data repository"@it .

echoes:database a skos:Concept ;
    dct:source "letters, consultation; source of definition: ISO/IEC 20944-1:2013(en)" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "collection of data organized according to a conceptual structure describing the characteristics of these data and the relationships among their corresponding entities, supporting one or more application areas"@en,
        "raccolta di dati organizzati secondo una struttura concettuale che descrive le caratteristiche di questi dati e le relazioni tra le entità corrispondenti, supportando una o più aree di applicazione"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "database"@en,
        "database"@it .

echoes:dataset a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: https://vocabs.sshopencloud.eu/browse/sshocterm/en/page/data_set_113" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "a collection of data, published or curated by a single agent, and available for access or download in one or more formats."@en,
        "una raccolta di dati, pubblicati o curati da un singolo agente, e disponibili per l'accesso o il download in uno o più formati."@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "dataset"@en,
        "dataset"@it .

echoes:digital_archive a skos:Concept ;
    dct:source "Source of term: letters; source of definition: ISO 24622-1:2015(en) [slightly adapted]" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "digital data repository dedicated to the long-term preservation of the associated data"@en,
        "repository di dati digitali dedicato alla conservazione a lungo termine dei dati associati"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "digital archive"@en,
        "archivio digitale"@it .

echoes:digital_commons a skos:Concept ;
    dct:source "Source of term: WP5.3 course; source of definition: Digital commons - Wikipedia" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "shared digital resources—such as software, knowledge, data, and cultural content—that are collectively produced and governed by a community and intended for public use"@en,
        "risorse digitali condivise, come software, conoscenze, dati e contenuti culturali, prodotte e governate collettivamente da una comunità e destinate all'uso pubblico"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "digital commons"@en,
        "beni digitali comuni"@it .

echoes:digital_ecosystem a skos:Concept ;
    dct:source "Source of term: website, WP5.3 course; source of definition: ECCCH_Report_FINAL.pdf" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "an open, adaptable, distributed and interoperable infrastructure that connects actors, activities, and cultural heritage objects through a user-friendly and unified graphical user interface designed to suit the needs of the fragmented CH communities"@en,
        "un'infrastruttura aperta, adattabile, distribuita e interoperabile che collega attori, attività e oggetti del patrimonio culturale attraverso un'interfaccia utente grafica intuitiva e unificata progettata per soddisfare le esigenze delle comunità CH frammentate"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "digital ecosystem"@en,
        "ecosistema digitale"@it .

echoes:digital_heritage a skos:Concept ;
    dct:source "Source of term: letters; source of definition: https://vocabularies.unesco.org/browser/thesaurus/en/page/?uri=http%3A%2F%2Fvocabularies.unesco.org%2Fthesaurus%2Fconcept8030   [exact]" ;
    skos:broader echoes:Cultural_Heritage ;
    skos:definition "unique resources of human knowledge and expression created digitally, or converted into digital form from existing analogue resources"@en,
        "risorse uniche di conoscenza ed espressione umana create digitalmente o convertite in formato digitale da risorse analogiche esistenti"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "digital heritage"@en,
        "patrimonio digitale"@it .

echoes:digital_tool a skos:Concept ;
    dct:source "Source of term: consultation, letters; source of definition: https://en.wikipedia.org/wiki/Technical_standard" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "a software application, system, or device that uses digital technology to perform a specific task or set of tasks for a specific purpose"@en,
        "un'applicazione software, un sistema o un dispositivo che utilizza la tecnologia digitale per eseguire un compito specifico o un insieme di compiti per uno scopo specifico"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "digital tool"@en,
        "strumento digitale"@it .

echoes:digitization a skos:Concept ;
    dct:source "Source of term: letters; source of definition: https://www.getty.edu/vow/AATFullDisplay?find=digitization&logic=AND&note=&english=N&prev_page=1&subjectid=300202383 [adapted]" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "the process of convertig information (e.g. objects, text, sound, images or audio) from an analogue format into an electronic digital code (bits and bytes) that can be read by computers or other electronic devices"@en,
        "il processo di conversione delle informazioni (ad es. oggetti, testo, suono, immagini o audio) da un formato analogico in un codice digitale elettronico (bit e byte) che può essere letto da computer o altri dispositivi elettronici"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "digitization"@en,
        "digitalizzazione"@it .

echoes:distributed_database a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: ISO/IEC 2382:2015(en)" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "database that is physically decentralized and handled by a database management system in a way that provides a logically centralized view of the database to the user"@en,
        "database che è fisicamente decentralizzato e gestito da un sistema di gestione del database in modo da fornire all'utente una vista logicamente centralizzata del database"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "distributed database"@en,
        "database distribuito"@it .

echoes:federated_architecture a skos:Concept ;
    dct:source "Source of term: WP5.3 course; source of definition: Sielli, A., Avgousti, A., Hermon, S., Demetrescu, E., Kowalska, J., Pawlikowski, K., Axaridou, A., Cignoni, P., Andújar, C., Durco, M., Kritsotakis, E., Theodoridou, M., Tzortzakakis, E., & Pitikakis, M. (2025). ECHOES Data Strategy for the CH Knowledge Base (D6.1). Zenodo. https://doi.org/10.5281/zenodo.17751757" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "a decentralised system design in which multiple autonomous components or subsystems integrate into a cohesive whole while retaining their independence and data ownership"@en,
        "un sistema decentralizzato in cui più componenti o sottosistemi autonomi si integrano in un insieme coeso pur mantenendo la loro indipendenza e proprietà dei dati"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "federated architecture"@en,
        "struttura decentralizzata"@it .

echoes:federated_infrastructure a skos:Concept ;
    dct:source "Source of term: WP5.3 course; source of definition: ECCCH_Report_FINAL.pdf" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "a distributed, decentralised information technology system designed to pool and share data and computing resources across multiple independent providers, allowing data to remain at its source while enabling secure access and processing through unified technical and semantic standards"@en,
        "un sistema informatico distribuito e decentralizzato progettato per mettere in comune e condividere dati e risorse informatiche tra più fornitori indipendenti, consentendo ai dati di rimanere alla fonte consentendo al contempo l'accesso e l'elaborazione sicuri attraverso standard tecnici e semantici unificati"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "federated infrastructure"@en,
        "infrastruttura federata"@it .

echoes:graph_database a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: https://memgraph.com/docs/data-modeling/graph-data-model" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "a database designed to store and manage data as a property graph, i.e. a network of nodes (entities) and relationships (connections) that each one might carry their own labels and properties"@en,
        "un database progettato per archiviare e gestire i dati come un grafico di proprietà, ovvero una rete di nodi (entità) e relazioni (connessioni) che possono avere ciascuna le proprie etichette e proprietà"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "graph database"@en,
        "database a grafo"@it .

echoes:heritage_digital_twin a skos:Concept ;
    dct:source "Source of term: WP5.3 course; source of definition: Sielli, A., Avgousti, A., Hermon, S., Demetrescu, E., Kowalska, J., Pawlikowski, K., Axaridou, A., Cignoni, P., Andújar, C., Durco, M., Kritsotakis, E., Theodoridou, M., Tzortzakakis, E., & Pitikakis, M. (2025). ECHOES Data Strategy for the CH Knowledge Base (D6.1). Zenodo. https://doi.org/10.5281/zenodo.17751757" ;
    skos:broader echoes:Cultural_Heritage ;
    skos:definition "complex, organized, digital information (including but not limited to data, metadata, paradata, workflows) about a real-world heritage asset, encompassing its tangible and intangible components, allowing for documentation, preservation and analysis"@en,
        "informazioni digitali complesse e organizzate (inclusi, a titolo esemplificativo ma non esaustivo, dati, metadati, paradati, flussi di lavoro) relative a un bene del patrimonio culturale reale, che ne comprendono le componenti materiali e immateriali, consentendone la documentazione, la conservazione e l'analisi"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "Heritage Digital Twin (HDT)"@en,
        "gemello digitale del patrimonio"@it .

echoes:heritage_professional a skos:Concept ;
    dct:source "Source of term: website; source of definition: based on ESS-net Culture Report 2012 and the ECHOES Charter" ;
    skos:broader echoes:Cultural_Heritage ;
    skos:definition "a professional having heritage-related skills acquired by formal, informal or professional training, preforming tasks within the cultural heritage cycle, i.e. preservation, studying, researching, documenting, dissemination, protection, and more, which may be carried out both within and outside the heritage field"@en,
        "un professionista con competenze relative al patrimonio acquisite attraverso la formazione formale, informale o professionale, che svolge compiti all'interno del ciclo del patrimonio culturale, vale a dire conservazione, studio, ricerca, documentazione, diffusione, protezione e altro, che possono essere svolti sia all'interno che all'esterno dell'ambito del patrimonio"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "heritage professional"@en,
        "professionista del patrimonio"@it .

echoes:horizontal_application a skos:Concept ;
    dct:source "Source of term: WP5.3 course; source of definition: Differences Between Horizontal and Vertical Applications - New Space Economy" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "software or application designed for a broad audience across various industries, offering general-purpose features"@en,
        "software o applicazione progettati per un vasto pubblico in vari settori, che offrono funzionalità generiche"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "horizontal application"@en,
        "integrazione orizzontale"@it .

echoes:hot_data a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: https://en.wikipedia.org/wiki/Graph_database" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "data in the computer storage that is frequently accessed"@en,
        "dati nella memoria del computer a cui si accede frequentemente"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "hot data"@en,
        "dati caldi"@it .

echoes:interoperability a skos:Concept ;
    dct:source "Source of term: WP5.3 course; source of definition: ECCCH_Report_FINAL.pdf" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "the actions necessary to ensure that services, applications, and tools can work with one another and that datasets can be used seamlessly regardless of origin, format, or the descriptions they carry, in a way that does not depend heavily on human involvement"@en,
        "le azioni necessarie per garantire che servizi, applicazioni e strumenti possano interagire tra loro e che i set di dati possano essere utilizzati senza soluzione di continuità, indipendentemente dalla loro origine, dal loro formato o dalle descrizioni che contengono, in modo tale da non dipendere in modo significativo dall'intervento umano"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "interoperability"@en,
        "interoperabilità"@it .

echoes:inventory_code a skos:Concept ;
    dct:source "Source of term: letters; source of definition: https://www.investopedia.com/terms/s/stock-keeping-unit-sku.asp [exact]" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "a short alphanumeric string that uniquely identifies a product or item in an inventory system maintained by a company, organisation or individual"@en,
        "una breve stringa alfanumerica che identifica in modo univoco un prodotto o un articolo in un sistema di inventario gestito da un'azienda, un'organizzazione o un individuo"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "inventory code"@en,
        "codice di inventario"@it .

echoes:knowledge_graph a skos:Concept ;
    dct:source "Source of term: website; source of definition: ISO/IEC 5392:2024(en)" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "graph representation of structured knowledge on concepts and relationships between them"@en,
        "rappresentazione grafica di conoscenze strutturate su concetti e relazioni tra loro"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "knowledge graph"@en,
        "grafo della conoscenza"@it .

echoes:metadata a skos:Concept ;
    dct:source "Source of term: letters, consultation; source of definition: ISO 55013:2024(en)" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "data that defines and describes other data"@en,
        "dati che definiscono e descrivono altri dati"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "metadata"@en,
        "metadati"@it .

echoes:museology a skos:Concept ;
    dct:source "Source of term: letters; source of definition: http://data.loterre.fr/ark:/67375/JLC-KZFQ1TDC-M" ;
    skos:broader echoes:Cultural_Heritage ;
    skos:definition "the theory and practice of the organisation, administration, functions, and technical processes of museums, including documentation and collections management, as well as their history, philosophy, and purposes."@en,
        "la teoria e la pratica dell'organizzazione, dell'amministrazione, delle funzioni e dei processi tecnici dei musei, compresa la documentazione e la gestione delle collezioni, nonché la loro storia, filosofia e scopi"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "museology"@en,
        "museologia"@it .

echoes:object-oriented_database a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: https://en.wikipedia.org/wiki/Object_database" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "a type of database in which information is represented in the form of objects, in contrast to relational databases which are table-oriented"@en,
        "un tipo di database in cui le informazioni sono rappresentate sotto forma di oggetti, a differenza dei database relazionali che sono orientati alle tabelle"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "object-oriented database"@en,
        "database object-oriented"@it .

echoes:ontology a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: https://www.iso.org/obp/ui/en/#iso:std:iso:25964:-2:ed-1:v1:en" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "a formal, explicit specification of a shared conceptualisation, defining concepts and their relationships in a way that machines can use for reasoning"@en,
        "una specificazione formale ed esplicita di una concettualizzazione condivisa, che definisce i concetti e le loro relazioni in un modo che le macchine possono utilizzare per il ragionamento"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "ontology"@en,
        "ontologia"@it .

echoes:open_file_format a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: https://en.wikipedia.org/wiki/Open_file_format" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "a type of file format for storing digital data defined by an openly published specification usually maintained by a standards organization, and which can be used and implemented by anyone"@en,
        "un tipo di formato di file per la memorizzazione di dati digitali definito da una specifica apertamente pubblicata solitamente gestita da un'organizzazione di standard e che può essere utilizzato e implementato da chiunque"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "open file format"@en,
        "formato file aperto"@it .

echoes:open_science a skos:Concept ;
    dct:source "Source of term: website; source of definition: https://vocabs.sshopencloud.eu/browse/sshocterm/en/page/open_science_167 [exact]" ;
    skos:broader echoes:Other_topics_of_interest ;
    skos:definition "the practice of science in such a way that others can collaborate, verify and contribute, where research data, lab notes and other research processes are freely available, under terms that enable reuse, redistribution and reproduction of the research and its underlying data and methods"@en,
        "la pratica della scienza in modo tale che altri possano collaborare, verificare e contribuire, dove i dati di ricerca, le note di laboratorio e altri processi di ricerca sono liberamente disponibili, a condizioni che consentono il riutilizzo, la ridistribuzione e la riproduzione della ricerca e dei dati e metodi sottostanti"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "open science"@en,
        "scienza aperta"@it .

echoes:photogrammetry a skos:Concept ;
    dct:source "Source of term: website; source of definition: ECCCH_Report_FINAL.pdf" ;
    skos:broader echoes:Cultural_Heritage ;
    skos:definition "data acquisition technology used to create high-fidelity 3D digital representations of physical objects, buildings, or archaeological sites by processing sets of 2D images"@en,
        "tecnologia di acquisizione dati utilizzata per creare rappresentazioni digitali 3D ad alta fedeltà di oggetti fisici, edifici o siti archeologici elaborando set di immagini 2D"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "photogrammetry"@en,
        "fotogrammetria"@it .

echoes:preservation a skos:Concept ;
    dct:source "Source of term: letters; source of definition: Herein System Terminology" ;
    skos:broader echoes:Cultural_Heritage ;
    skos:definition "the process of safeguarding cultural heritage, whether an object, a building, or an area, in the widest sense and by means of legal protection, rehabilitation, material conservation, security, presentation etc."@en,
        "il processo di salvaguardia del patrimonio culturale, sia esso un oggetto, un edificio o un'area, nel senso più ampio e attraverso la protezione legale, la riabilitazione, la conservazione dei materiali, la sicurezza, la presentazione, ecc."@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "preservation"@en,
        "preservazione"@it .

echoes:primary_dataset a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: https://www.wikidata.org/wiki/Q2110223" ;
    skos:broader echoes:Cultural_Heritage ;
    skos:definition "data collected from a source, which has not been subject to any other manipulation by a software program or a human researcher, analyst or technician"@en,
        "dati raccolti da una fonte, che non è stata oggetto di alcuna altra manipolazione da parte di un programma software o di un ricercatore, analista o tecnico umano"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "primary dataset"@en,
        "dataset primario"@it .

echoes:proprietary_format a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: https://en.wikipedia.org/wiki/Proprietary_file_format" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "a file format of a company, organization, or individual that contains data that is ordered and stored according to a particular encoding-scheme"@en,
        "un formato di file di un'azienda, un'organizzazione o un individuo che contiene dati ordinati e archiviati in base a un particolare schema di codifica"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "proprietary format"@en,
        "formato proprietario"@it .

echoes:relational_database a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: https://en.wikipedia.org/wiki/Relational_database [adapted]" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "a database that stores data in structured tables consisting of rows and columns, where relationships between data are defined through keys, enabling efficient querying, updating, and integrity constraints"@en,
        "un database che memorizza i dati in tabelle strutturate costituite da righe e colonne, in cui le relazioni tra i dati sono definite tramite chiavi, consentendo query efficienti, aggiornamenti e vincoli di integrità"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "relational database"@en,
        "database relazionale"@it .

echoes:rendering a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: ISO/IEC 2382:2015(en)" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "conversion of the geometry, coloring, texturing, lighting, and other characteristics of a scene into a display image"@en,
        "conversione della geometria, della colorazione, della texture, dell'illuminazione e di altre caratteristiche di una scena in un'immagine di visualizzazione"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "rendering"@en,
        "rendering"@it .

echoes:research_data_management a skos:Concept ;
    dct:source "Source of term: letters; source of definition: https://loterre.istex.fr/TSO/en/page/-GDCXNW8F-5 [adapted]" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "the systematic process of organising, describing, storing, sharing, protecting, and preserving data generated or used throughout the research lifecycle"@en,
        "il processo sistematico di organizzazione, descrizione, archiviazione, condivisione, protezione e conservazione dei dati generati o utilizzati durante l'intero ciclo di vita della ricerca"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "research data management"@en,
        "gestione dei dati della ricerca"@it .

echoes:rural_ruin a skos:Concept ;
    dct:source "Source of term: letters; source of definition: https://www.collinsdictionary.com/dictionary/english/ruin   [exact]" ;
    skos:broader echoes:Cultural_Heritage ;
    skos:definition "the remains of structures or buildings located in the countryside, often abandoned and partially collapsed, reflecting past rural life and land use"@en,
        "i resti di strutture o edifici situati in campagna, spesso abbandonati e parzialmente crollati, che riflettono la vita rurale del passato e l'uso del suolo"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "rural ruin"@en,
        "rovina rurale"@it .

echoes:derived_dataset a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: https://loterre.istex.fr/TSO/en/page/-D80R1KX4-5" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "data resulting from the interpretation of data initially produced by another researcher, available in journals, repositories, archives and other publications."@en,
        "dati derivanti dall'interpretazione di dati inizialmente prodotti da un altro ricercatore, disponibili su riviste, repository, archivi e altre pubblicazioni."@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "derived dataset"@en,
        "dataset derivato"@it .

echoes:server a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: https://en.wikipedia.org/wiki/Server_(computing)" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "a computer or software system that provides data, resources, or services to other computers (clients) over a network"@en,
        "un sistema informatico o software che fornisce dati, risorse o servizi ad altri computer (client) su una rete"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "server"@en,
        "server"@it .

echoes:service a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: https://vocabs.acdh.oeaw.ac.at/arche_category/en/page/service" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "a system that provides one or more functions of value to the end-user"@en,
        "un sistema che fornisce una o più funzioni di valore all'utente finale"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "service"@en,
        "servizio"@it .

echoes:spatialisation a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: https://en.wikipedia.org/wiki/Spatialization" ;
    skos:broader echoes:Cultural_Heritage ;
    skos:definition "the spatial forms that social activities and material things, phenomena or processes take on in geography, sociology, urban planning and cultural studies"@en,
        "le forme spaziali che le attività sociali e le cose, i fenomeni o i processi materiali assumono in geografia, sociologia, urbanistica e studi culturali"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "spatialisation"@en,
        "spazializzazione"@it .

echoes:standard a skos:Concept ;
    dct:source "Source of term: consultation; source of definition: Pollé, A., Vendrix, P., Czech, L., Petitcol, R., Gallini, C., Stadlinger, E., Steindl, C., Puhr, A., Marçal, E., Szatucsek, Z., Habibi Minelli, S., & Nowak, A. (2025). ECHOES Founding principles of the Cloud Governance (D10.1). Zenodo. https://doi.org/10.5281/zenodo.17599162" ;
    skos:broader echoes:Cultural_Heritage ;
    skos:definition "a set of established – sometimes also de facto – norms that serve as a reference for ensuring consistency, quality, and interoperability in processes, products, or organisational structures"@en,
        "un insieme di norme consolidate – a volte anche di fatto – che fungono da riferimento per garantire coerenza, qualità e interoperabilità nei processi, nei prodotti o nelle strutture organizzative"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "standard"@en,
        "standard"@it .

echoes:sustainability a skos:Concept ;
    dct:source "Source of term: letters; source of definition: Pollé, A., Vendrix, P., Czech, L., Petitcol, R., Gallini, C., Stadlinger, E., Steindl, C., Puhr, A., Marçal, E., Szatucsek, Z., Habibi Minelli, S., & Nowak, A. (2025). ECHOES Founding principles of the Cloud Governance (D10.1). Zenodo. https://doi.org/10.5281/zenodo.17599162" ;
    skos:broader echoes:Cultural_Heritage ;
    skos:definition "a multifaceted principle that ensures the long-term viability and impact of an organisation or infrastructure"@en,
        "un principio sfaccettato che garantisce la fattibilità e l'impatto a lungo termine di un'organizzazione o di un'infrastruttura"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "sustainability"@en,
        "sostenibilità"@it .

echoes:geospatial_database a skos:Concept ;
    dct:source "Source of term: letters; source of definition: https://www.felt.com/blog/geospatial-database" ;
    skos:broader echoes:Information_Science_and_Data_Management ;
    skos:definition "a digital database that captures and stores detailed geographic and spatial information about the Earth's surface and human-made structures"@en,
        "un database digitale che acquisisce e memorizza informazioni geografiche e spaziali dettagliate sulla superficie terrestre e sulle strutture costruite dall'uomo"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "geospatial database"@en,
        "banca dati geospaziale"@it .

echoes:urban_heritage a skos:Concept ;
    dct:source "Source of term: letters; source of definition: https://whc.unesco.org/en/hul/ [adapted]" ;
    skos:broader echoes:Cultural_Heritage ;
    skos:definition "heritage resources located in urban contexts, consisting of tangible and intangible heritage assets, which together express historically accumulated cultural, social and spatial values associated with urban communities"@en,
        "risorse del patrimonio situate in contesti urbani, costituite da beni del patrimonio tangibile e intangibile, che insieme esprimono valori culturali, sociali e spaziali storicamente accumulati associati alle comunità urbane"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "urban heritage"@en,
        "patrimonio urbano"@it .

echoes:vertical_application a skos:Concept ;
    dct:source "Source of term: WP5.3 course; source of definition: Differences Between Horizontal and Vertical Applications - New Space Economy" ;
    skos:broader echoes:Cultural_Heritage ;
    skos:definition "a cross-layer specialized application, normally with a GUI (Graphical User Interface), within the ECHOES infrastructure that integrates/uses components from multiple architectural levels to showcase the end-to-end exploitation of platform services"@en,
        "un'applicazione specializzata cross-layer, normalmente con una GUI (Graphical User Interface), all'interno dell'infrastruttura ECHOES che integra/utilizza componenti provenienti da più livelli architetturali per mostrare lo sfruttamento end-to-end dei servizi della piattaforma"@it ;
    skos:inScheme echoes: ;
    skos:prefLabel "vertical application"@en,
        "integrazione verticale"@it .



echoes:Other_topics_of_interest a skos:Concept ;
    skos:inScheme echoes: ;
    skos:narrower echoes:Common_European_Data_Space,
        echoes:Common_European_Data_Space_for_Cultural_Heritage,
        echoes:UNESCO,
        echoes:climate,
        echoes:conservation,
        echoes:cooperation,
        echoes:cultural_heritage_cloud,
        echoes:cultural_heritage_institution,
        echoes:culture,
        echoes:data_analysis,
        echoes:data_management_plan,
        echoes:open_science,
        echoes:painting_material ;
